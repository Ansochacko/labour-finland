{
  "schema_version": 1,
  "records": [],
  "allowed_verification_statuses": [
    "VERIFIED",
    "REVIEW_REQUIRED",
    "EXPIRED",
    "UNVERIFIED"
  ],
  "required_fields_for_publication": [
    "id",
    "topic",
    "path",
    "summary",
